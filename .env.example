# ---- storage -------------------------------------------------------------------------------------------------
# Render/any host: use a hosted MongoDB (e.g. Atlas). "memory://" loses all data on every restart (fine for demos/tests only).
DATABASE_URL=mongodb://localhost:27017/wingo
ADMIN_API_KEY=change-me                 # required header X-API-Key for every write endpoint; leave empty only on localhost
ALLOWED_ORIGINS=http://localhost:8000   # only needed if the browser calls the backend directly. Via the Vercel /api rewrite it is same-origin.
AUTO_SEED=true                          # loads data/wingo_transcribed.csv (802 rounds, NO period ids / timestamps) when the DB is empty
AUTO_BACKTEST=true

# ---- live data source: OFF unless you have an API you are allowed to use ---------------------------------------
SYNC_ENABLED=false
SYNC_SOURCE_URL=                        # e.g. https://api.provider.example/v1/wingo/history   (JSON, GET)
SYNC_LIST_PATH=                         # dot path to the list inside the JSON, e.g. data.list ("" if the root is the list)
SYNC_PERIOD_FIELD=                      # field with the round / period id (digits)
SYNC_NUMBER_FIELD=                      # field with the drawn number 0-9
SYNC_TIME_FIELD=                        # field with the draw time (ISO-8601, or epoch seconds/ms). REQUIRED for the countdown.
SYNC_HEADERS_JSON=                      # e.g. {"Authorization":"Bearer ..."}  - credentials live ONLY here, never in the frontend
SYNC_INTERVAL_SECONDS=10                # minimum 10. Be gentle with the provider; respect its rate limits.
SYNC_FAST_INTERVAL_SECONDS=5            # used only while a round has just ended and its result is not in yet
SYNC_RESPECT_ROBOTS=true
SYNC_ALLOW_GAPS=false
SYNC_START_AFTER_PERIOD=                # needed once if you start syncing on top of history that has no period ids

# ---- period clock (the schedule is VERIFIED from stored timestamps, never assumed) -------------------------------
PERIOD_SECONDS=60
SOURCE_TIMEZONE=UTC                     # zone of timestamps WITHOUT an offset, e.g. Asia/Kolkata. Wrong value => "timestamp in the future" => no countdown
TIMESTAMP_MEANS=end                     # "end" = the timestamp is when the round finished; "start" = when it began
CLOCK_TOLERANCE_SECONDS=5
CLOCK_MIN_SAMPLES=5
LATE_GRACE_SECONDS=20                   # after the boundary: "Awaiting result" for this long, then "Result overdue"
UI_POLL_SECONDS=10
